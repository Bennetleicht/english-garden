# Kopiere diese Datei nach ".env.local" und trage deine (kostenlosen) Schlüssel ein.
# Mindestens EINER der beiden KI-Schlüssel wird benötigt. Beide sind kostenlos.

# Empfohlen: Google Gemini (kostenlos, ohne Kreditkarte) – https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: Groq (kostenlos, ohne Kreditkarte) – https://console.groq.com/keys
# Wird zusätzlich für die Spracherkennung in Browsern ohne eingebaute Erkennung (z. B. Firefox) genutzt.
GROQ_API_KEY=

# Optional: anderes Modell erzwingen (nur ändern, wenn ein Modell abgeschaltet wurde)
# Gemini-Standard: gemini-flash-latest  |  Groq-Standard: llama-3.3-70b-versatile
AI_MODEL=

# Optional: Zugangscode, damit Fremde mit dem Link nicht dein Gratis-Kontingent verbrauchen.
# Wenn gesetzt, wird beim ersten KI-Aufruf einmalig nach diesem Code gefragt.
ACCESS_CODE=
